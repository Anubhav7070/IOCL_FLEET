<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- SMTP Mail Config -->
    <add key="EmailHost" value="smtp.gmail.com" />
    <add key="EmailPort" value="587" />
    <add key="EmailUser" value="singhanubhav1562@gmail.com" />
    <add key="EmailPass" value="hjaxqkvddzjhgwai" />
    <add key="EmailFromName" value="IOCL Vehicle Compliance System" />
    <add key="EmailFromAddress" value="singhanubhav1562@gmail.com" />
    <!-- AD Authentication Config -->
    <!-- Set ADAuthenticationMode to "Real" to authenticate against Active Directory -->
    <!-- Set ADAuthenticationMode to "Mock" to authenticate against the local SQLite DB (for development/testing) -->
    <add key="ADAuthenticationMode" value="Mock" />
    <!-- Replace with your actual AD domain name (e.g. iocl.local or iocl.ad.in) -->
    <add key="ADDomain" value="iocl.local" />
    <!-- Optional: Full LDAP path if domain auto-discovery does not work on intranet -->
    <!-- Example: ldap://dc01.iocl.local:389 -->
    <add key="ADLDAPServer" value="" />
  </appSettings>
  <connectionStrings>
    <add name="SQLiteDB" connectionString="Data Source=|DataDirectory|iocl_compliance_forms.db;Version=3;" providerName="System.Data.SQLite" />
  </connectionStrings>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Login.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
  <system.web>
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="System.Data.SQLite, Version=1.0.118.0, Culture=neutral, PublicKeyToken=db937bc2d44ff139" />
        <add assembly="System.DirectoryServices.AccountManagement, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
      </assemblies>
    </compilation>
    <!-- 20MB upload limit for PDF compliance certificates -->
    <httpRuntime targetFramework="4.8" maxRequestLength="20480" executionTimeout="300" />
    <customErrors mode="Off" />
    <pages enableSessionState="true" enableViewState="true" />
    <sessionState timeout="120" />
    <machineKey
      validationKey="A3F8B2C1D4E5F6A7B8C9D0E1F2A3B4C5D6E7F8A9B0C1D2E3F4A5B6C7D8E9F0A1"
      decryptionKey="B4C5D6E7F8A9B0C1D2E3F4A5B6C7D8E9F0A1B2C3D4E5F6A7B8C9D0E1F2A3B4C5"
      validation="SHA1"
      decryption="AES" />
  </system.web>
</configuration>

